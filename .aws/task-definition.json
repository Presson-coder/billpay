{
  "family": "billpay",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/billpayTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "billpay",
      "image": "IMAGE_PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_H2_CONSOLE_ENABLED", "value": "false" },
        { "name": "BILLPAY_GATEWAY_TIMEOUT", "value": "3s" },
        { "name": "JAVA_OPTS", "value": "-XX:MaxRAMPercentage=75.0" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fs http://localhost:8080/actuator/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/billpay",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "billpay",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
